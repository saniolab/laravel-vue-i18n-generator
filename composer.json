{
    "name": "saniolab/laravel-vue-i18n-generator",
    "description": "Generates a vue-i18n compatible include file from your Laravel translations.",
    "license": "MIT",
    "keywords": [
        "laravel",
        "vue-i18n"
    ],
    "authors": [
        {
            "name": "Martin Lindhe",
            "email": "martin@ubique.se"
        },
        {
            "name": "Tony Murray",
            "email": "murraytony@gmail.com"
        }
    ],
    "homepage": "https://github.com/saniolab/laravel-vue-i18n-generator",
    "support": {
        "issues": "https://github.com/saniolab/laravel-vue-i18n-generator/issues",
        "source": "https://github.com/saniolab/laravel-vue-i18n-generator"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5.50|^12.5.8|^13.0.0"
    },
    "autoload": {
        "psr-4": {
            "Saniolab\\VueInternationalizationGenerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Saniolab\\VueInternationalizationGenerator\\GeneratorProvider"
            ]
        }
    }
}
